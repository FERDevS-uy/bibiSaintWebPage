---
import HeroBannerCarousel from "@components/HeroBannerCarousel.astro";
import Layout from "@layouts/Layout.astro";
import ProductCarousel from "@components/ProductCarousel.astro";
import { ProductListHydrator } from "@stores/ProductListHydrator";
import { loadFeaturedProducts } from "@server/catalog/facade";
import { toCardProduct } from "@server/catalog/mappers";
import { getSupabase } from "@server/supabase";
import { catalogReadEnv } from "@server/catalog/http";
import { createCatalogQueryTelemetry } from "@server/catalog/queryTelemetry";

const env = catalogReadEnv((Astro.locals as { runtime?: { env?: Record<string, string | undefined> } }).runtime?.env);
const telemetry = createCatalogQueryTelemetry("home");

const featured = await loadFeaturedProducts(env, getSupabase, { telemetry });
const novedades = featured.novedades.map(toCardProduct);
const destacados = featured.destacados.map(toCardProduct);
const ofertas = featured.ofertas.map(toCardProduct);

const hydratorProducts = [...new Set([...novedades, ...destacados, ...ofertas])].map(p => ({
  id: p.id,
  name: p.name,
  price: p.price,
  img: p.img[0],
  enOferta: Boolean(p.enOferta),
}));
---

<Layout pageId="index">
  <ProductListHydrator client:load products={hydratorProducts} />
  <HeroBannerCarousel />
  <ProductCarousel products={novedades} title="¡Novedades!" id="novedades" />
  <ProductCarousel products={destacados} title="¡Destacados!" id="destacados" />
  <ProductCarousel products={ofertas} title="¡Ofertas!" id="ofertas" />
</Layout>
