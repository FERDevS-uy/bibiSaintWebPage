---
import ListarProductos from "@components/ListarProductos.astro";
import Layout from "@layouts/Layout.astro";
import { loadCategoryProducts } from "@utils/loadProducts";
import { getSidebarCategories } from "@server/sidebarCategories";
import { config } from "src/config";
import SideBardCategories from "@components/SideBardCategories.astro";
import { withBasePath } from "@utils/basePath";
import "../../../style.css";

const CANT_PRODUCTOS = config.postPerPage;
const { id, subcat, pag } = Astro.params;

const subCats = await getSidebarCategories(id ?? "");

const { products, total } = await loadCategoryProducts({
  category: id!,
  subcategory: subcat,
  page: Number(pag),
  pageSize: CANT_PRODUCTOS,
});

const totalPages = Math.ceil(total / CANT_PRODUCTOS);
const baseUrl = withBasePath(`/categories/${id}/${subcat}`, Astro.url.pathname);
---

<Layout
  categorySelected={id}
  pageTitle={`${config.pageTitle} - ${id} / ${subcat} / page ${pag}`}
>
  <div class="categories__container">
    <SideBardCategories
      categoryFather={id!}
      arrayCategorys={subCats}
      products={products}
    />
    <ListarProductos
      products={products}
      totalPages={totalPages}
      actualPage={Number(pag)}
      baseURL={baseUrl}
    />
  </div>
</Layout>
