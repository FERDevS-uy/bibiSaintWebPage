---
import ListarProductos from "@components/ListarProductos.astro";
import Layout from "@layouts/Layout.astro";
import { getSidebarCategories } from "@server/sidebarCategories";
import { config } from "src/config";
import SideBardCategories from "@components/SideBardCategories.astro";
import { withBasePath } from "@utils/basePath";
import { loadCatalogPage, isReadModel } from "@server/catalog/facade";
import { toCardProduct } from "@server/catalog/mappers";
import { getSupabase } from "@server/supabase";
import { catalogReadEnv } from "@server/catalog/http";
import "../../style.css";

const CANT_PRODUCTOS = config.postPerPage;
const { id, pag } = Astro.params;

const env = catalogReadEnv((Astro.locals as { runtime?: { env?: Record<string, string | undefined> } }).runtime?.env);

const pageNum = Number(pag);
const cursor = Astro.url.searchParams.get("cursor") ?? undefined;

// El cursor opaco viaja como query param. En read model, [pag] > 1 SIN cursor
// (URL indexada antigua) no puede derivar el cursor keyset → redirigir a
// página 1 (riesgo R1 del contrato). En legacy los números de página son
// válidos y no se redirige.
if (isReadModel(env) && pageNum > 1 && !cursor) {
  return Astro.redirect(withBasePath(`/categories/${id}/page/1`, Astro.url.pathname));
}

const [subCat, res] = await Promise.all([
  getSidebarCategories(id ?? ""),
  loadCatalogPage(
    { category: id, sort: "nombre", pageSize: CANT_PRODUCTOS, cursor, page: pageNum },
    env,
    getSupabase,
  ),
]);
const products = res.items.map(toCardProduct);
const total = res.total;

const totalPages = Math.ceil(total / CANT_PRODUCTOS);
const baseUrl = withBasePath(`/categories/${id}`, Astro.url.pathname);
---

<Layout
  categorySelected={id}
  pageTitle={`${config.pageTitle} - ${id} / page ${pag}`}
  pageId="categories"
>
  <div class="categories__container">
    <SideBardCategories
      categoryFather={id!}
      arrayCategorys={subCat}
      products={products}
    />
    <ListarProductos
      products={products}
      totalPages={totalPages}
      actualPage={Number(pag)}
      baseURL={baseUrl}
      nextCursor={res.nextCursor ?? undefined}
      prevCursor={cursor}
    />
  </div>
</Layout>
