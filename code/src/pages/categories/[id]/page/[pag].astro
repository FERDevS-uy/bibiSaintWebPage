---
import ListarProductos from "@components/ListarProductos.astro";
import Layout from "@layouts/Layout.astro";
import { getSidebarCategories } from "@server/sidebarCategories";
import { config } from "src/config";
import SideBardCategories from "@components/SideBardCategories.astro";
import { withBasePath } from "@utils/basePath";
import { loadCatalogPage } from "@server/catalog/facade";
import { toCardProduct } from "@server/catalog/mappers";
import { getSupabase } from "@server/supabase";
import { CatalogError } from "@server/catalog/contracts";
import { createCatalogQueryTelemetry } from "@server/catalog/queryTelemetry";
import type { CatalogCacheEnv } from "@server/catalog/edgeCache";
import "../../style.css";

const CANT_PRODUCTOS = config.postPerPage;
const { id, pag } = Astro.params;

type RuntimeCatalogEnv = {
  CATALOG_KV?: CatalogCacheEnv["CATALOG_KV"];
};
const runtimeEnv = (Astro.locals as { runtime?: { env?: RuntimeCatalogEnv } })
  .runtime?.env;
const env = { CATALOG_KV: runtimeEnv?.CATALOG_KV };
const telemetry = createCatalogQueryTelemetry("category-page");

const pageNum = Number(pag);
const cursor = Astro.url.searchParams.get("cursor") ?? undefined;

if (!Number.isInteger(pageNum) || pageNum < 1) {
  return Astro.redirect("/404", 404);
}

let subCat: Awaited<ReturnType<typeof getSidebarCategories>>;
let res: Awaited<ReturnType<typeof loadCatalogPage>>;
try {
  [subCat, res] = await Promise.all([
    getSidebarCategories(id ?? "", { kv: runtimeEnv?.CATALOG_KV }),
    loadCatalogPage(
      {
        category: id,
        sort: "nombre",
        pageSize: CANT_PRODUCTOS,
        cursor,
        page: pageNum,
      },
      env,
      getSupabase,
      { telemetry },
    ),
  ]);
} catch (err) {
  if (err instanceof CatalogError) {
    return Astro.redirect("/404", 404);
  }
  throw err;
}
const products = res.items.map(toCardProduct);
const total = res.total;

const totalPages = Math.ceil(total / CANT_PRODUCTOS);
if (totalPages >= 1 && pageNum > totalPages) {
  return Astro.redirect("/404", 404);
}
const baseUrl = withBasePath(`/categories/${id}`, Astro.url.pathname);
---

<Layout
  categorySelected={id}
  pageTitle={`${config.pageTitle} - ${id} / page ${pag}`}
  pageId="categories"
>
  <div class="categories__container">
    <SideBardCategories
      categoryFather={id!}
      arrayCategorys={subCat}
      products={products}
    />
    <ListarProductos
      products={products}
      totalPages={totalPages}
      actualPage={Number(pag)}
      baseURL={baseUrl}
      nextCursor={res.nextCursor ?? undefined}
      prevCursor={res.previousCursor ?? undefined}
    />
  </div>
</Layout>
