---
import Layout from "../../layouts/Layout.astro";
import { getProductPageState } from "@server/product/pageState";
import ProductInfoPanel from "@components/producto/ProductInfoPanel.astro";
import { config } from "src/config";

const state = await getProductPageState(Astro);

if (!state) {
  return Astro.redirect("/404", 404);
}
---

<Layout
  pageTitle={`${config.pageTitle} - ${state.product.name}`}
  description={state.product.description}
  pageImage={state.product.img[0]}
>
  <ProductInfoPanel
    product={state.product}
    relacionados={state.relacionados}
    displayCategoryName={state.displayCategoryName}
    groupSubcategory={state.groupSubcategory}
    leafSubcategory={state.leafSubcategory}
    isRopa={state.isRopa}
    disableColorSelection={state.disableColorSelection}
    showRuntimeStockCheck={state.showRuntimeStockCheck}
    primaryProviderLink={state.primaryProviderLink}
    pathname={state.pathname}
    priceValue={state.priceValue}
    validOriginalPrice={state.validOriginalPrice}
    hasValidOffer={state.hasValidOffer}
  />
</Layout>

<script>
  import { initProductDetail } from "@client/productDetail";
  document.addEventListener("astro:page-load", initProductDetail);
</script>