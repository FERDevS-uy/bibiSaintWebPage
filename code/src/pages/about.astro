---
import Layout from "../layouts/Layout.astro";
import { config } from "../config";

export const prerender = true;
---

<Layout pageTitle={`${config.pageTitle} - Sobre nosotros`}>
  <section class="contact-container">
    <div class="contact-info">
      <div class="section-heading">
        <span class="section-kicker">Bibi’s Tienda & Bienestar</span>
        <h1>Quiénes somos</h1>
        <span class="heading-rule" aria-hidden="true"></span>
      </div>

      <div class="story-copy">
        <p>
          Descubrí una tienda online diferente, donde encontrás productos para el hogar,
          vestimenta, accesorios y mucho más. Nos apasiona acercarte calidad, novedades y
          soluciones para tu día a día.
        </p>
        <p>
          También ofrecemos servicios holísticos personalizados para acompañarte en tu
          crecimiento personal.
        </p>
      </div>

      <section class="services-list" aria-labelledby="services-title">
        <h2 id="services-title">Servicios</h2>
        <ul>
          <li><span>Codificación Biológica</span><strong>USD 80</strong></li>
          <li><span>Carta Numerológica</span><strong>USD 80</strong></li>
          <li><span>Tutorías individuales online para estudiantes de EUTM, Medicina y Agronomía</span><strong>USD 50<span class="per-hour"> / hora</span></strong></li>
        </ul>
      </section>

      <p class="cta-text">
        ¿Tenés una duda, consulta o buscás un producto o servicio particular? Escribinos y
        nos pondremos en contacto a la brevedad.
      </p>
    </div>

    <div class="contact-form-wrapper">
      <form
        class="contact-form"
        action="https://formspree.io/f/mwvzalvq"
        method="POST"
      >
        <input type="hidden" name="_subject" value="Nuevo mensaje desde el formulario de contacto" />
        <input type="hidden" name="_language" value="es" />
        <input type="text" name="name" placeholder="Nombre Completo" required />
        <input type="email" name="email" placeholder="Correo electrónico" required />
        <input type="tel" name="phone" placeholder="Número de Teléfono" required />
        <input type="text" name="subject" placeholder="Asunto" required />
        <textarea name="message" placeholder="Tu Mensaje" rows="8" required></textarea>
        <button type="submit">Enviar</button>
      </form>
    </div>
  </section>
</Layout>

<style>
  .contact-container {
    width: min(1120px, 100%);
    box-sizing: border-box;
    margin: clamp(2rem, 5vw, 4.5rem) auto;
    padding: 0 clamp(1rem, 4vw, 2.5rem);
    display: grid;
    grid-template-columns: minmax(0, 1.05fr) minmax(320px, 0.95fr);
    gap: clamp(2.5rem, 7vw, 6rem);
    font-family: "Poppins", "Poppins Fallback", sans-serif;
    color: var(--principal-text-color);
  }

  .section-heading { margin-bottom: 2rem; }
  .section-kicker {
    display: block;
    color: var(--orange-color);
    font-size: 0.72rem;
    font-weight: 800;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    margin-bottom: 0.65rem;
  }
  h1 {
    font-size: clamp(2rem, 4vw, 3.25rem);
    line-height: 1.08;
    letter-spacing: -0.035em;
    margin: 0;
  }
  .heading-rule {
    display: block;
    width: 4.5rem;
    height: 0.28rem;
    border-radius: 0.25rem;
    background: var(--line-color);
    margin-top: 1.2rem;
  }
  .story-copy { max-width: 62ch; }
  .story-copy p, .cta-text {
    font-size: clamp(1rem, 1.4vw, 1.08rem);
    line-height: 1.8;
    margin: 0 0 1.35rem;
  }
  .services-list {
    margin: 2.5rem 0 2rem;
    padding-top: 1.5rem;
    border-top: 1px solid rgba(35, 41, 70, 0.16);
  }
  .services-list h2 { font-size: 1.15rem; margin: 0 0 1rem; }
  .services-list ul { list-style: none; padding: 0; margin: 0; }
  .services-list li {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1rem;
    padding: 0.8rem 0;
    border-bottom: 1px solid rgba(35, 41, 70, 0.1);
    line-height: 1.5;
  }
  .services-list li strong { white-space: nowrap; color: var(--orange-color); }
  .per-hour { font-size: 0.78em; font-weight: 600; }
  .cta-text { margin-top: 2rem; }

  .contact-details {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }

  .icon-wrapper {
    min-width: 40px; /* Fixed width for icon container to align text */
    text-align: center;
    display: flex;
    justify-content: center;
    padding-top: 2px;
  }

  .icon-wrapper svg {
    color: #999; /* Example gray color */
    width: 32px;
    height: 32px;
    stroke-width: 1.5;
  }
  .icon-wrapper.mobile svg {
    /* Adjust specific icon styles if needed */
    height: 48px; /* Phone icon in design looks simpler/outline */
    width: 40px;
    opacity: 0.4;
  }
  .icon-wrapper.pin svg {
    /* Adjust specific icon styles if needed */
    height: 48px;
    width: 40px;
    opacity: 0.4;
  }

  .detail-text {
    display: flex;
    flex-direction: column;
    font-size: 0.95rem;
    line-height: 1.4;
  }

  .social-links {
    display: flex;
    gap: 1rem;
  }

  .social-icon {
    /* Base styles handled by global styles or reset here if needed */
    color: #3b5998; /* Default for facebook-ish */
  }
  .social-icon.facebook {
    color: #3b5998;
  }
  .social-icon.instagram {
    color: #8a3ab9; /* approx gradient fallback */
  }
  .social-icon.whatsapp {
    color: #25d366;
  }

  /* Right Column - Form */
  .contact-form-wrapper {
    flex: 1;
    align-self: start;
    margin-top: clamp(0rem, 4vw, 2.7rem);
    padding: clamp(1.4rem, 3vw, 2.25rem);
    background: #fffdf8;
    border: 1px solid rgba(35, 41, 70, 0.1);
    border-radius: 16px;
    box-shadow: 0 14px 35px rgba(35, 41, 70, 0.08);
  }

  .contact-form {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }

  input,
  textarea {
    width: 100%;
    padding: 12px 15px;
    border: 1px solid rgba(35, 41, 70, 0.28);
    border-radius: 10px;
    font-size: 1rem;
    color: #555;
    background: #fff;
    outline: none;
    font-family: inherit;
  }

  textarea {
    border-radius: 20px; /* Less rounded for textarea usually, but image shows rounded corners */
    resize: vertical;
  }

  input::placeholder,
  textarea::placeholder {
    color: #888;
  }

  button {
    background-color: #e86c1a; /* Orange from design approx */
    width: 100%;
    color: white;
    border: none;
    padding: 10px 30px;
    border-radius: 10px;
    font-weight: 700;
    font-size: 1.1rem;
    cursor: pointer;
    align-self: flex-start;
    transition: background 0.3s;
  }

  button:hover {
    background-color: #d65a0f;
  }

  .form-feedback {
    color: #164f2c;
    font-size: 0.95rem;
    min-height: 1.3rem;
    margin-top: -0.5rem;
  }

  @media (max-width: 768px) {
    .contact-container {
      grid-template-columns: 1fr;
      gap: 2rem;
    }

    .contact-form-wrapper {
      margin-top: 0;
    }

    .services-list li { align-items: flex-start; }
  }

  @media screen and (min-width: 1000px) {
    button {
      width: auto;
      border-radius: 25px;
    }
  }
</style>
