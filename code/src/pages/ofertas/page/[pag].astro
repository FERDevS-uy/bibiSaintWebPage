---
import Layout from "@layouts/Layout.astro";
import ListarProductos from "@components/ListarProductos.astro";
import { config } from "src/config";
import { withBasePath } from "@utils/basePath";
import { loadCatalogPage, isReadModel } from "@server/catalog/facade";
import { toCardProduct } from "@server/catalog/mappers";
import { getSupabase } from "@server/supabase";
import { catalogReadEnv } from "@server/catalog/http";
import { createCatalogQueryTelemetry } from "@server/catalog/queryTelemetry";

const env = catalogReadEnv((Astro.locals as { runtime?: { env?: Record<string, string | undefined> } }).runtime?.env);
const telemetry = createCatalogQueryTelemetry("offers-page");

const productsPerPage = config.postPerPage;
const { pag } = Astro.params;
const pageNum = Number(pag);
const cursor = Astro.url.searchParams.get("cursor") ?? undefined;

// El cursor opaco viaja como query param. En read model, [pag] > 1 SIN cursor
// (URL indexada antigua) no puede derivar el cursor keyset → redirigir a
// página 1 (riesgo R1 del contrato). En legacy los números de página son
// válidos y no se redirige.
if (isReadModel(env) && pageNum > 1 && !cursor) {
  return Astro.redirect(withBasePath("/ofertas/page/1", Astro.url.pathname));
}

const res = await loadCatalogPage(
  { sort: "precio", enOferta: true, pageSize: productsPerPage, cursor, page: pageNum },
  env,
  getSupabase,
  { telemetry },
);
const topBaratos = res.items.map(toCardProduct);
const total = res.total;

const totalPages = Math.ceil(total / productsPerPage);
const products = topBaratos;
const actualPage = pageNum;
const totalProducts = total;
const offersBaseUrl = withBasePath("/ofertas", Astro.url.pathname);
---

<Layout pageTitle={`Bibi's - Ofertas (${actualPage}/${totalPages})`} pageId="offers">
  <section class="offersHeader">
    <span class="offersBadge">Precio bajo asegurado</span>
    <h1>Ofertas destacadas</h1>
    <p>Top 50 productos más baratos del catálogo, ordenados de menor a mayor precio.</p>
    <div class="offersMeta">
      <span>{totalProducts} productos</span>
      <span>Página {actualPage} de {totalPages}</span>
    </div>
  </section>

  <ListarProductos
    products={products}
    totalPages={totalPages}
    actualPage={actualPage}
    baseURL={offersBaseUrl}
    nextCursor={res.nextCursor ?? undefined}
    prevCursor={cursor}
  />
</Layout>

<style>
  .offersHeader {
    width: min(1040px, 94%);
    margin: 1.4rem auto 0.9rem;
    padding: clamp(1rem, 2.5vw, 1.5rem);
    text-align: center;
    border-radius: 16px;
    border: 1px solid rgba(35, 41, 70, 0.1);
    background:
      radial-gradient(circle at 20% 0%, rgba(210, 232, 255, 0.6), transparent 40%),
      radial-gradient(circle at 80% 100%, rgba(255, 222, 186, 0.6), transparent 38%),
      #ffffff;
    box-shadow: 0 8px 24px rgba(35, 41, 70, 0.08);
  }

  .offersBadge {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 0.35rem 0.8rem;
    border-radius: 999px;
    background: #232946;
    color: #fff;
    font-size: 0.73rem;
    text-transform: uppercase;
    font-weight: 700;
    letter-spacing: 0.08em;
  }

  .offersHeader h1 {
    margin: 0.55rem 0 0;
    font-size: clamp(1.8rem, 3.6vw, 2.6rem);
    color: var(--principal-text-color);
    line-height: 1.1;
  }

  .offersHeader p {
    margin: 0.5rem auto 0;
    color: #4e577b;
    max-width: 58ch;
    font-size: clamp(0.95rem, 1.6vw, 1.05rem);
  }

  .offersMeta {
    margin-top: 0.8rem;
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
  }

  .offersMeta span {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 108px;
    padding: 0.35rem 0.65rem;
    border-radius: 999px;
    border: 1px solid rgba(35, 41, 70, 0.18);
    color: #232946;
    font-size: 0.83rem;
    font-weight: 600;
    background: rgba(255, 255, 255, 0.85);
  }

  @media (max-width: 700px) {
    .offersHeader {
      margin-top: 1rem;
      margin-bottom: 0.6rem;
      border-radius: 12px;
      padding: 0.95rem 0.8rem;
    }

    .offersMeta {
      width: 100%;
      justify-content: center;
      flex-wrap: wrap;
      gap: 0.45rem;
    }

    .offersMeta span {
      min-width: 0;
      flex: 1 1 auto;
      max-width: 170px;
    }
  }
</style>
