<style is:global>
  /* Fallback con métricas ajustadas para minimizar el "salto" al cargar Poppins.
     Se declara global para que pueda referenciarse desde estilos scoped. */
  @font-face {
    font-family: "Poppins Fallback";
    src: local("Arial");
    size-adjust: 112%;
    ascent-override: 92%;
    descent-override: 24%;
    line-gap-override: 0%;
  }

  :root {
    /* Eje único de alineación horizontal. Referencia: instrucciones-inner (1000px). */
    --max-width-container: 1000px;
    --principal-background-color: #f7f6f2;
    --principal-background-color-dark: #d5c4a4;
    --principal-background-color-light: #fff9ed;
    --principal-text-color: #232946;
    --secondary-background-color: #fff5ba;
    --secondary-text-color: #fff;
    --orange-color: #e86c1a;

    --menu-size: 3rem;
    --header-height: 75px;
    --header-icon-size: 10rem;
    --line-color: #f0b13e;
    --p-b-color: #c11010;
    --s-b-color: #e42618;
    --h-gradient: linear-gradient(135deg, #e43f3f 0%, #b81c1c 100%);

    --colums-of-products: 4;
    --product-square-size: 200px;
  }

  /* Contenedor único reutilizable para el eje de alineación horizontal.
     El padding interno se contempla dentro del ancho (box-sizing: border-box),
     no aumenta el ancho efectivo del contenedor. */
  .app-container {
    width: 100%;
    max-width: var(--max-width-container);
    margin: 0 auto;
    box-sizing: border-box;
  }

  html {
    overflow-x: clip;
  }

  * {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
    font-family: "Poppins", "Poppins Fallback", "Segoe UI", Arial, sans-serif;
    /* Evita el faux-bold del fallback mientras carga Poppins. */
    font-synthesis: none;
  }

  .hidden {
    display: none;
  }

  .centerBox {
    display: flex;
    justify-content: center;
    align-items: center;
    min-height: 500px;
  }
</style>
