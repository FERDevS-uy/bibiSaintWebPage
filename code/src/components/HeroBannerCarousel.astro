---
import { withBasePath } from "@utils/basePath";

const pathname = Astro.url.pathname;
const ofertasHref = withBasePath("/ofertas", pathname);

const images = ["banner1", "banner2", "banner3", "banner4", "banner5"];
const total = images.length;
---

<section
  class="hero-carousel"
  aria-label="Carrusel de ofertas destacadas"
  role="region"
  aria-roledescription="carousel"
  data-carousel=""
  data-total={total}
>
  <div class="hero-carousel__images">
    {images.map((name, i) => (
      <picture class="hero-carousel__slide" data-index={i} data-active={i === 0 ? "" : undefined}>
        <img
          src={withBasePath(`/${name}.jpeg`, pathname)}
          alt=""
          width="1920"
          height="450"
          loading={i === 0 ? "eager" : "lazy"}
          fetchpriority={i === 0 ? "high" : "auto"}
          decoding="async"
        />
      </picture>
    ))}
  </div>

  <div class="hero-carousel__overlay"></div>

  <div class="hero-carousel__content">
    <span class="hero-carousel__pill">Top precios</span>
    <h1>Ofertas para renovar tu casa</h1>
    <p>Encontrá los productos más convenientes en un solo lugar.</p>
    <a class="hero-carousel__cta" href={ofertasHref}>Descubrir ofertas</a>
  </div>

  <button class="hero-carousel__arrow hero-carousel__arrow--prev" aria-label="Anterior" type="button">
    <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="#333" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="15 18 9 12 15 6"/></svg>
  </button>

  <button class="hero-carousel__arrow hero-carousel__arrow--next" aria-label="Siguiente" type="button">
    <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="#333" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="9 18 15 12 9 6"/></svg>
  </button>

  <div class="hero-carousel__dots" role="tablist" aria-label="Seleccionar slide">
    {images.map((_, i) => (
      <button
        class="hero-carousel__dot"
        role="tab"
        aria-label={`Ir al slide ${i + 1}`}
        aria-selected={i === 0}
        data-index={i}
        type="button" data-active={i === 0 ? "" : undefined}
      ></button>
    ))}
  </div>
</section>

<style>
  .hero-carousel {
    position: relative;
    width: 100vw;
    margin-left: calc(50% - 50vw);
    margin-right: calc(50% - 50vw);
    margin-bottom: 2.8rem;
    overflow: hidden;
    background: #2d1f18;
    aspect-ratio: 1920 / 450;
    user-select: none;
  }

  /* --- Slides --- */
  .hero-carousel__images {
    position: absolute;
    inset: 0;
  }

  .hero-carousel__slide {
    position: absolute;
    inset: 0;
    opacity: 0;
    transition: opacity 600ms ease-in-out;
    will-change: opacity;
  }

  .hero-carousel__slide[data-active] {
    opacity: 1;
  }

  .hero-carousel__slide img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  /* --- Overlay --- */
  .hero-carousel__overlay {
    position: absolute;
    inset: 0;
    z-index: 1;
    background:
      linear-gradient(97deg, rgba(14, 10, 7, 0.83) 0%, rgba(14, 10, 7, 0.5) 35%, rgba(14, 10, 7, 0.2) 62%, rgba(14, 10, 7, 0.14) 100%),
      linear-gradient(180deg, rgba(14, 10, 7, 0.05) 0%, rgba(14, 10, 7, 0.4) 100%);
    pointer-events: none;
  }

  /* --- Content (static) --- */
  .hero-carousel__content {
    position: absolute;
    inset: 0;
    z-index: 2;
    max-width: 680px;
    box-sizing: border-box;
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    text-align: center;
    gap: 0.62rem;
    padding: clamp(0.9rem, 2.2vw, 1.55rem);
    text-wrap: pretty;
    margin-inline: auto;
    pointer-events: none;
  }

  .hero-carousel__pill {
    width: fit-content;
    font-size: 0.62rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: #ffe8c4;
    font-weight: 800;
    padding: 0.25rem 0.62rem;
    border-radius: 999px;
    border: 1px solid rgba(255, 224, 178, 0.4);
    background: rgba(74, 49, 34, 0.45);
    backdrop-filter: blur(2px);
  }

  .hero-carousel__content h1 {
    margin: 0;
    color: #fff6e7;
    text-shadow: 0 5px 14px rgba(0, 0, 0, 0.35);
    font-size: clamp(1.8rem, 4.5vw, 3.5rem);
    line-height: 1.08;
    font-weight: 800;
    max-width: 14ch;
    overflow-wrap: anywhere;
  }

  .hero-carousel__content p {
    margin: 0;
    color: #f2dfc7;
    max-width: 34ch;
    line-height: 1.33;
    font-size: clamp(1rem, 1.4vw, 1.25rem);
    text-shadow: 0 3px 10px rgba(0, 0, 0, 0.35);
    overflow-wrap: anywhere;
  }

  .hero-carousel__cta {
    margin-top: 0.32rem;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    border-radius: 999px;
    padding: 0.56rem 1.08rem;
    border: 1px solid rgba(254, 239, 213, 0.75);
    color: #1f130c;
    background: linear-gradient(135deg, #ffe4b8 0%, #ffcc8f 100%);
    font-size: 0.78rem;
    font-weight: 800;
    letter-spacing: 0.03em;
    text-transform: uppercase;
    text-decoration: none;
    box-shadow: 0 8px 14px rgba(0, 0, 0, 0.24);
    transition: transform 0.2s ease, filter 0.2s ease;
    pointer-events: all;
    cursor: pointer;
  }

  .hero-carousel__cta:hover {
    transform: translateY(-2px);
    filter: brightness(1.04);
  }

  /* --- Arrows --- */
  .hero-carousel__arrow {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    width: 64px;
    height: 64px;
    border-radius: 50%;
    background: #fff;
    border: none;
    box-shadow: 0 10px 30px rgba(0, 0, 0, 0.15);
    cursor: pointer;
    z-index: 10;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: transform 250ms ease, box-shadow 250ms ease;
  }

  .hero-carousel__arrow:hover {
    transform: translateY(-50%) scale(1.05);
    box-shadow: 0 14px 35px rgba(0, 0, 0, 0.2);
  }

  .hero-carousel__arrow:focus-visible {
    outline: 2px solid #fff;
    outline-offset: 3px;
  }

  .hero-carousel__arrow--prev {
    left: 24px;
  }

  .hero-carousel__arrow--next {
    right: 24px;
  }

  /* --- Dots --- */
  .hero-carousel__dots {
    position: absolute;
    bottom: 6px;
    left: 50%;
    transform: translateX(-50%);
    z-index: 10;
    display: flex;
    gap: 10px;
    padding: 8px 12px;
    background: rgba(255, 255, 255, 0.6);
    backdrop-filter: blur(6px);
    -webkit-backdrop-filter: blur(6px);
    border-radius: 9999px;
  }

  .hero-carousel__dot {
    width: 12px;
    height: 12px;
    border-radius: 50%;
    border: none;
    background: #D1D5DB;
    cursor: pointer;
    transition: background 300ms ease, scale 300ms ease;
    padding: 0;
  }

  .hero-carousel__dot[data-active] {
    background: #fff;
    scale: 1.1;
  }

  .hero-carousel__dot:focus-visible {
    outline: 2px solid #fff;
    outline-offset: 3px;
  }

  /* --- Responsive --- */
  @media screen and (max-width: 999px) {
    .hero-carousel__arrow {
      width: 56px;
      height: 56px;
    }

    .hero-carousel__arrow svg {
      width: 24px;
      height: 24px;
    }
  }

  @media screen and (max-width: 900px) {
    .hero-carousel__overlay {
      display: none;
    }

    .hero-carousel__content {
      position: static;
      max-width: none;
      width: 100%;
      gap: 0.66rem;
      padding: 0.9rem 0.82rem 1rem;
      background: linear-gradient(180deg, #2a1d15 0%, #1f140f 100%);
      align-items: center;
      text-align: center;
    }

    .hero-carousel__content h1 {
      font-size: clamp(1.45rem, 5.5vw, 2rem);
      max-width: 14ch;
      line-height: 1.13;
    }

    .hero-carousel__content p {
      max-width: 34ch;
      font-size: clamp(0.95rem, 2.5vw, 1.1rem);
    }

    .hero-carousel__pill {
      font-size: 0.56rem;
      padding: 0.22rem 0.54rem;
    }

    .hero-carousel__cta {
      font-size: 0.72rem;
      padding: 0.5rem 0.95rem;
    }

    .hero-carousel {
      aspect-ratio: auto;
    }

    .hero-carousel__images {
      position: relative;
      aspect-ratio: 1920 / 450;
    }

    .hero-carousel__arrow {
      top: calc(100vw * 225 / 1920);
    }

    .hero-carousel__arrow--prev {
      left: 12px;
    }

    .hero-carousel__arrow--next {
      right: 12px;
    }

    .hero-carousel__arrow:hover {
      transform: translateY(-50%) scale(1.05);
    }

    .hero-carousel__dots {
      position: absolute;
      bottom: auto;
      top: calc(100vw * 450 / 1920);
      transform: translateX(-50%) translateY(-100%);
      padding: 6px 12px 4px;
    }
  }

  @media screen and (max-width: 767px) {
    .hero-carousel__arrow {
      width: 48px;
      height: 48px;
    }

    .hero-carousel__arrow svg {
      width: 22px;
      height: 22px;
    }

    .hero-carousel__arrow--prev {
      left: 12px;
    }

    .hero-carousel__arrow--next {
      right: 12px;
    }

    .hero-carousel__content {
      padding: 0.78rem 0.72rem 0.88rem;
    }

    .hero-carousel__content h1 {
      font-size: clamp(1.3rem, 6.5vw, 1.6rem);
      max-width: 14ch;
    }

    .hero-carousel__content p {
      font-size: clamp(0.9rem, 3vw, 1rem);
      max-width: 34ch;
      line-height: 1.3;
    }

    .hero-carousel__cta {
      width: 100%;
      justify-content: center;
      font-size: 0.69rem;
      padding: 0.48rem 0.88rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero-carousel__slide {
      transition: none;
    }

    .hero-carousel__arrow {
      transition: none;
    }

    .hero-carousel__arrow:hover {
      transform: translateY(-50%);
    }

    .hero-carousel__dot {
      transition: none;
    }

    .hero-carousel__cta {
      transition: none;
    }
  }
</style>

<script>
  document.addEventListener("astro:page-load", () => {
    const section = document.querySelector("[data-carousel]");
    if (!section || section.dataset.carouselInitialized) return;
    section.dataset.carouselInitialized = "true";

    const total = parseInt(section.dataset.total, 10);
    const slides = section.querySelectorAll(".hero-carousel__slide");
    const dots = section.querySelectorAll(".hero-carousel__dot");
    const prevBtn = section.querySelector(".hero-carousel__arrow--prev");
    const nextBtn = section.querySelector(".hero-carousel__arrow--next");

    let active = 0;
    let paused = false;
    let timer = null;
    let prefersReducedMotion = false;

    const motionQuery = window.matchMedia("(prefers-reduced-motion: reduce)");
    prefersReducedMotion = motionQuery.matches;
    motionQuery.addEventListener("change", (e) => {
      prefersReducedMotion = e.matches;
    });

    function goTo(index) {
      if (index === active) return;
      slides.forEach((slide, i) => {
        slide.toggleAttribute("data-active", i === index);
      });
      dots.forEach((dot, i) => {
        dot.toggleAttribute("data-active", i === index);
        dot.setAttribute("aria-selected", String(i === index));
      });
      active = index;
      resetTimer();
      if (!prefersReducedMotion) preloadNext();
    }

    function next() {
      goTo((active + 1) % total);
    }

    function prev() {
      goTo((active - 1 + total) % total);
    }

    function preloadNext() {
      const nextIdx = (active + 1) % total;
      const img = slides[nextIdx]?.querySelector("img");
      if (img && !img.complete) {
        const preload = new Image();
        preload.src = img.src;
      }
    }

    function resetTimer() {
      if (timer) clearInterval(timer);
      if (!paused) {
        timer = setInterval(next, 5000);
      }
    }

    function startAutoplay() {
      paused = false;
      resetTimer();
    }

    function stopAutoplay() {
      paused = true;
      if (timer) {
        clearInterval(timer);
        timer = null;
      }
    }

    goTo(0);

    prevBtn?.addEventListener("click", prev);
    nextBtn?.addEventListener("click", next);

    dots.forEach((dot) => {
      dot.addEventListener("click", () => {
        goTo(parseInt(dot.dataset.index, 10));
      });
    });

    section.addEventListener("mouseenter", stopAutoplay);
    section.addEventListener("mouseleave", startAutoplay);

    document.addEventListener("keydown", (e) => {
      if (e.key === "ArrowLeft" && section.matches(":focus-within")) {
        prev();
        e.preventDefault();
      }
      if (e.key === "ArrowRight" && section.matches(":focus-within")) {
        next();
        e.preventDefault();
      }
    });

    let touchStartX = 0;
    let touchEndX = 0;
    section.addEventListener(
      "touchstart",
      (e) => {
        touchStartX = e.changedTouches[0].screenX;
      },
      { passive: true },
    );
    section.addEventListener(
      "touchend",
      (e) => {
        touchEndX = e.changedTouches[0].screenX;
        const diff = touchStartX - touchEndX;
        if (Math.abs(diff) > 50) {
          if (diff > 0) next();
          else prev();
        }
      },
      { passive: true },
    );

    resetTimer();
  });
</script>
