---
// Barra de instrucciones de compra — visible en el home debajo del navbar
---



  <div class="instrucciones-bar">
      <div class="instrucciones-inner">
        <div class="paso">
          <span class="numero">1</span>
          <p>Añadí al carrito todos los<br /> productos que desees</p>
        </div>

        <div class="paso">
          <span class="numero">2</span>
          <p>Revisá tu compra y<br /> finalizá tu pedido</p>
        </div>

        <div class="paso">
          <span class="numero">3</span>
          <p>Enviá por WhatsApp<br /> tu pedido</p>
        </div>
      </div>
    </div>

<style>
  .instrucciones-bar {
    background: linear-gradient(120deg, #c62828 0%, #8e1414 100%);
    width: 100%;
    box-sizing: border-box;
    padding: 14px 1rem;
  }

  .instrucciones-inner {
    max-width: 1000px;
    margin: 0 auto;
    display: flex;
    flex-direction: row;
    align-items: center;
    justify-content: center;
    gap: 14px;
    flex-wrap: wrap;
  }

  .paso {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 6px 14px;
    flex: 1;
    min-width: 200px;
    justify-content: center;
    border-radius: 999px;
    background: rgba(255, 255, 255, 0.12);
    box-shadow: inset 0 0 0 1px rgba(255, 255, 255, 0.22);
  }

  .numero {
    flex-shrink: 0;
    width: 40px;
    height: 40px;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 1.15rem;
    font-weight: 800;
    color: #8e1414;
    background: #fff;
  }

  .paso p {
    margin: 0;
    font-size: 0.86rem;
    font-weight: 650;
    color: #ffffff;
    line-height: 1.4;
    text-shadow: 0 1px 2px rgba(0, 0, 0, 0.25);
    letter-spacing: 0.01em;
  }

  @media (max-width: 999px) {
    .instrucciones-bar {
      padding: 10px 0;
      overflow-x: auto;
      /* Hide scrollbar for a cleaner look */
      -ms-overflow-style: none;  /* IE and Edge */
      scrollbar-width: none;  /* Firefox */
    }
    .instrucciones-bar::-webkit-scrollbar {
      display: none;
    }
    .instrucciones-inner {
      flex-direction: column;
      flex-wrap: nowrap;
      justify-content: flex-start;
      gap: 8px;
      width: max-content;
      padding-inline: 10px;
    }
    .paso {
      min-width: 250px;
      padding: 4px 10px;
      justify-content: flex-start;
    }
  }
  @media (max-width: 767px) {
    .instrucciones-bar { padding: 14px 12px; overflow: visible; }
    .instrucciones-bar .instrucciones-inner { width: 100%; padding: 0; gap: 0; display: grid; grid-template-columns: repeat(3,minmax(0,1fr)); align-items: stretch; }
    .instrucciones-bar .paso { min-width: 0; padding: 0 8px; background: none; box-shadow: none; border: 0; border-radius: 0; display: flex; flex-direction: column; align-items: center; justify-content: flex-start; gap: 8px; }
    .instrucciones-bar .numero { width: 28px; height: 28px; font-size: .9rem; font-weight: 800; background: #fff9ed; color: #8e1414; }
    .instrucciones-bar .paso p { font-size: .875rem; line-height: 1.45; font-weight: 600; letter-spacing: 0; color: #fff9ed; text-shadow: none; text-align: center; overflow-wrap: normal; hyphens: none; }
    .instrucciones-bar .paso br { display: none; }
    .instrucciones-bar .paso + .paso { border-left: 1px solid rgba(255,249,237,.25); }
  }
</style>
