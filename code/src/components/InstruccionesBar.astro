---
// Barra de instrucciones de compra — visible en el home debajo del navbar
---

<div class="instrucciones-bar">
  <div class="instrucciones-inner">
    <div class="paso">
      <span class="numero">1</span>
      <p>Añadí al carrito todos los<br />productos que desees</p>
    </div>

    <div class="paso">
      <span class="numero">2</span>
      <p>Revisá tu compra y<br />finalizá tu pedido</p>
    </div>

    <div class="paso">
      <span class="numero">3</span>
      <p>Enviá por WhatsApp<br />tu pedido</p>
    </div>
  </div>
</div>


<style>
  .instrucciones-bar {
    background: linear-gradient(120deg, #c62828 0%, #8e1414 100%);
    width: 100%;
    box-sizing: border-box;
    padding: 14px 1rem;
  }

  .instrucciones-inner {
    max-width: 1000px;
    margin: 0 auto;
    display: flex;
    flex-direction: row;
    align-items: center;
    justify-content: center;
    gap: 14px;
    flex-wrap: wrap;
  }

  .paso {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 6px 14px;
    flex: 1;
    min-width: 200px;
    justify-content: center;
    border-radius: 999px;
    background: rgba(255, 255, 255, 0.12);
    box-shadow: inset 0 0 0 1px rgba(255, 255, 255, 0.22);
  }

  .numero {
    flex-shrink: 0;
    width: 40px;
    height: 40px;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 1.15rem;
    font-weight: 800;
    color: #8e1414;
    background: #fff;
  }

  .paso p {
    margin: 0;
    font-size: 0.86rem;
    font-weight: 650;
    color: #ffffff;
    line-height: 1.4;
    text-shadow: 0 1px 2px rgba(0, 0, 0, 0.25);
    letter-spacing: 0.01em;
  }

  @media (max-width: 999px) {
    .instrucciones-bar {
      padding: 10px 0;
      overflow-x: auto;
      /* Hide scrollbar for a cleaner look */
      -ms-overflow-style: none;  /* IE and Edge */
      scrollbar-width: none;  /* Firefox */
    }
    .instrucciones-bar::-webkit-scrollbar {
      display: none;
    }
    .instrucciones-inner {
      flex-direction: column;
      flex-wrap: nowrap;
      justify-content: flex-start;
      gap: 8px;
      width: max-content;
      padding-inline: 10px;
    }
    .paso {
      min-width: 250px;
      padding: 4px 10px;
      justify-content: flex-start;
    }
  }
</style>
