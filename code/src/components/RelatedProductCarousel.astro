---
import type Product from "../types/product";
import { withBasePath } from "@utils/basePath";
import { isTallBoot } from "@utils/isTallBoot";
import { formatPrice, parsePrice } from "@utils/price";

interface Props {
  products: Product[];
  title?: string;
  id: string;
}

const { products, title = "Productos Relacionados", id } = Astro.props;
const pathname = Astro.url.pathname;
---

<div class="related" id={id} data-carousel="">
    <div class="related__header">
      <h2 class="related__title">{title}</h2>
      <span class="related__count">{products.length} {products.length === 1 ? "producto" : "productos"}</span>
    </div>

    <div class="related__viewport">
      <button class="related__arrow related__arrow--prev" aria-label="Anterior" type="button">
        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="15 18 9 12 15 6"/></svg>
      </button>

  <div class="related__track" role="list">
    {products.map((p, index) => {
      const tall = isTallBoot(p.name, p.description, p.id);
      return (
        <article
          class={`related__item${tall ? " related__item--tall" : ""}`}
          role="listitem"
          data-index={index}
        >
          <a
            href={withBasePath(`/producto/${p.id}`, pathname)}
            class="related__link"
            title={p.name}
            tabindex="0"
          >
            <div
              class={`related__img-wrap${tall ? " related__img-wrap--tall" : ""}`}
            >
              <img
                src={p.img[0]}
                alt={p.name}
                loading="lazy"
                decoding="async"
                class={`related__img${tall ? " related__img--tall" : ""}`}
              />
            </div>
            <div class="related__info">
              <span class="related__name">{p.name}</span>
              <span class="related__price">${formatPrice(parsePrice(p.price))}</span>
            </div>
          </a>
        </article>
      );
    })}
  </div>
      <button class="related__arrow related__arrow--next" aria-label="Siguiente" type="button">
        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="9 18 15 12 9 6"/></svg>
      </button>
    </div>
  </div>

<style>
  .related {
    margin-top: 60px;
    padding-block: 40px;
    background: rgba(0, 0, 0, 0.015);
    border-radius: 16px;
  }

  .related__header {
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: 2px;
    text-align: center;
    padding-inline: max(15vw, 1.5rem);
    margin-bottom: 22px;
  }

  .related__title {
    font-size: clamp(1.6rem, 2.4vw, 2.2rem);
    font-weight: 700;
    color: var(--principal-text-color);
    letter-spacing: -0.02em;
    margin: 0;
  }

  .related__count {
    font-size: 0.85rem;
    font-weight: 500;
    color: var(--principal-text-color);
    opacity: 0.6;
  }

  .related__viewport {
    position: relative;
    width: 100%;
  }

  .related__track {
    display: flex;
    gap: 20px;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scrollbar-width: none;
    width: 100%;
    padding-block: 8px;
    padding-inline: max(1.5rem, 5vw);
    -webkit-overflow-scrolling: touch;
  }

  .related__track::-webkit-scrollbar {
    display: none;
  }

  .related__item {
    flex: 0 0 65vw;
    scroll-snap-align: start;
    scroll-snap-stop: always;
    display: flex;
    flex-direction: column;
    align-items: center;
    position: relative;
    cursor: pointer;
    will-change: transform;
  }

  .related__link {
    text-decoration: none;
    color: inherit;
    display: flex;
    flex-direction: column;
    height: 100%;
  }

  .related__link:focus-visible {
    outline: 2px solid var(--p-b-color, #c11010);
    outline-offset: 2px;
    border-radius: 8px;
  }

  .related__img-wrap {
    width: 100%;
    aspect-ratio: 1 / 1;
    overflow: hidden;
    border-radius: 14px;
    background: #ffffff;
    border: 1px solid #e8e6df;
    transition: box-shadow 0.35s ease, border-color 0.35s ease;
  }

  .related__item--tall {
    background: transparent;
  }

  .related__img-wrap--tall {
    background: #fcfcfc;
  }

  .related__item:hover .related__img-wrap {
    border-color: var(--line-color, #f0b13e);
    box-shadow: 0 0 0 2px rgba(240, 177, 62, 0.15);
  }

  .related__img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: top;
    display: block;
    transition: transform 0.4s ease;
  }

  .related__item:hover .related__img:not(.related__img--tall) {
    transform: scale(1.03);
  }

  .related__img--tall {
    object-fit: contain !important;
    object-position: center !important;
  }

  .related__info {
    width: 100%;
    padding: 10px 4px 4px;
    text-align: center;
    display: flex;
    flex-direction: column;
    flex: 1;
  }

  .related__name {
    font-size: 0.85rem;
    font-weight: 650;
    color: var(--principal-text-color);
    line-height: 1.35;
    overflow-wrap: anywhere;
    transition: color 0.25s ease;
  }

  .related__item:hover .related__name {
    color: #c11010;
  }

  .related__price {
    display: block;
    font-size: 1.1rem;
    font-weight: 800;
    color: #c11010;
    margin-top: auto;
    padding-top: 3px;
  }

  .related__arrow {
    display: none;
  }

  @media (min-width: 1000px) {
    .related {
      margin-top: 80px;
      padding-block: 48px;
    }

    .related__header {
      padding-inline: max(15vw, 2rem);
    }

    .related__title {
      font-size: clamp(1.6rem, 2.4vw, 2.2rem);
    }

    .related__track {
      gap: 20px;
      padding-inline: max(1.5rem, 5vw);
      scroll-snap-type: none;
    }

    .related__item {
      flex: 0 0 calc((100% - 2 * 20px) / 3);
      scroll-snap-align: unset;
      scroll-snap-stop: unset;
    }

    .related__info {
      padding: 12px 6px 6px;
    }

    .related__name {
      font-size: 0.85rem;
    }

    .related__price {
      font-size: 1.1rem;
    }

    .related__arrow {
      display: flex;
      align-items: center;
      justify-content: center;
      position: absolute;
      top: 50%;
      transform: translateY(-50%);
      width: 42px;
      height: 42px;
      border-radius: 50%;
      border: none;
      background: #ffffff;
      color: var(--principal-text-color);
      cursor: pointer;
      z-index: 10;
      box-shadow: 0 2px 8px rgba(0, 0, 0, 0.1), 0 1px 2px rgba(0, 0, 0, 0.06);
      transition: background 0.2s ease, color 0.2s ease, box-shadow 0.2s ease, transform 0.2s ease;
      opacity: 0;
      pointer-events: none;
    }

    .related:hover .related__arrow {
      opacity: 1;
      pointer-events: auto;
    }

    .related__arrow:hover {
      background: var(--line-color, #f0b13e);
      color: #ffffff;
      box-shadow: 0 4px 14px rgba(240, 177, 62, 0.35);
      transform: translateY(-50%) scale(1.06);
    }

    .related__arrow--prev {
      left: -18px;
    }

    .related__arrow--next {
      right: -18px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .related__track {
      scroll-behavior: auto;
    }

    .related__img {
      transition: none;
    }

    .related__item:hover .related__img {
      transform: none;
    }

    .related__arrow {
      transition: none;
    }

    .related__arrow:hover {
      transform: translateY(-50%);
    }
  }
</style>

<script>
  const SEL = {
    carousel: ".related[data-carousel]",
    track: ".related__track",
    item: ".related__item",
    prevBtn: ".related__arrow--prev",
    nextBtn: ".related__arrow--next",
  } as const;

  const SWIPE_THRESHOLD = 40;
  const GAP = 20;

  document.addEventListener("astro:page-load", () => {
    document.querySelectorAll<HTMLElement>(SEL.carousel).forEach(initRelated);
  });

  function initRelated(container: HTMLElement): void {
    if (container.dataset.initialized) return;
    container.dataset.initialized = "true";

    const track = container.querySelector<HTMLElement>(SEL.track);
    const prevBtn = container.querySelector<HTMLButtonElement>(SEL.prevBtn);
    const nextBtn = container.querySelector<HTMLButtonElement>(SEL.nextBtn);

    if (!track) return;

    // --- Navegación por flechas/teclado/swipe: mismo patrón que el home (2 ítems por paso) ---
    function scrollStep(forward: boolean): void {
      const itemWidth = (track.querySelector(SEL.item) as HTMLElement)?.offsetWidth || 250;
      track.scrollBy({ left: (forward ? 1 : -1) * (itemWidth + GAP) * 2, behavior: "smooth" });
    }

    prevBtn?.addEventListener("click", () => scrollStep(false));
    nextBtn?.addEventListener("click", () => scrollStep(true));

    // Touch swipe
    let touchStartX = 0;
    track.addEventListener(
      "touchstart",
      (e) => {
        touchStartX = e.changedTouches[0].screenX;
      },
      { passive: true },
    );

    track.addEventListener(
      "touchend",
      (e) => {
        const diff = touchStartX - e.changedTouches[0].screenX;
        if (Math.abs(diff) > SWIPE_THRESHOLD) {
          scrollStep(diff > 0);
        }
      },
      { passive: true },
    );

    // Teclado
    document.addEventListener("keydown", (e) => {
      if (!container.contains(document.activeElement)) return;
      if (e.key === "ArrowLeft" || e.key === "ArrowRight") {
        e.preventDefault();
        scrollStep(e.key === "ArrowRight");
      }
    });
  }
</script>
