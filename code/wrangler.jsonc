/**
 * Cloudflare Workers config for the Astro SSR build.
 *
 * - El adapter @astrojs/cloudflare emite `dist/_worker.js/index.js` + `dist/`
 *   con los assets prerendereados.
 * - Workers Static Assets sirve `dist/` y delega al worker cuando una ruta
 *   coincide con una Server Island / endpoint SSR.
 *
 * Variables públicas no sensibles se versionan acá para que Wrangler sea la
 * fuente de verdad. Los secretos siguen en Cloudflare Dashboard o `wrangler secret put`.
 *
 * Docs: https://developers.cloudflare.com/workers/static-assets/binding/
 */
{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "bibisaintwebpage",
	"main": "./dist/_worker.js/index.js",
	"compatibility_date": "2025-11-12",
	"compatibility_flags": ["nodejs_compat"],
	"assets": {
		"directory": "./dist",
		"binding": "ASSETS"
	},
	"kv_namespaces": [
		{
			"binding": "CATALOG_KV",
			"id": "2aff9e8fa0dd402f93efce436f11124b"
		}
	],
	"routes": [
		{
			"pattern": "espaciobibis.com.uy",
			"zone_name": "espaciobibis.com.uy",
			"custom_domain": true,
			"enabled": true,
			"previews_enabled": false
		}
	],
	"vars": {
		"CATALOG_READ_MODEL": "true",
		"ENABLE_CSV_FALLBACK": "false",
		"PUBLIC_SITE_URL": "https://espaciobibis.com.uy"
	},
	"env": {
		"dev": {
			"name": "bibisaintwebpage-dev",
			"main": "./dist/_worker.js/index.js",
			"assets": {
				"directory": "./dist",
				"binding": "ASSETS"
			},
			"kv_namespaces": [
				{
					"binding": "CATALOG_KV",
					"id": "eab3cdb8f79f49e49f3eeddc903e106f"
				},
				{
					"binding": "SESSION",
					"id": "ad2a966d1e0c4176aa34b848b948b2fe"
				}
			],
			"observability": {
				"enabled": true,
				"traces": {
					"enabled": true
				}
			}
		}
	},
	"observability": {
		"enabled": true,
		"redact_query_string": true,
		"logs": {
			"enabled": true,
			"head_sampling_rate": 1,
			"persist": true,
			"invocation_logs": true
		},
		"traces": {
			"enabled": true,
			"persist": true,
			"head_sampling_rate": 1
		}
	}
}
